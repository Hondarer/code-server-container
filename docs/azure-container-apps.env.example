# Azure Container Apps deployment variables (Secretは保存しない)
#
# `./aca-environment.sh init`がリポジトリ外へ配置し、SUFFIXを設定する。

RESOURCE_GROUP=rg-code-server
LOCATION=japaneast
ENVIRONMENT_NAME=cae-code-server
IDENTITY_NAME=id-code-server-acrpull
IMAGE_REPOSITORY=code-server-ol8
APP_NAME_PREFIX=code-server-ol8
FILE_SHARE_PREFIX=code-server
ENV_STORAGE_PREFIX=code-server
PASSWORD_DIR="$HOME/.azure/code-server-aca/instances"
FILE_SHARE_QUOTA_GIB=40

# code-server App 1 replicaあたりのリソース。init Jobは1.0 vCPU / 2Giのまま。
CONTAINER_APP_CPU=4.0
CONTAINER_APP_MEMORY=8Gi

# publish後のcreate/updateで適用するContainer Appのスケーリング設定。
# disabledは常時1 replica、enabledはHTTPトラフィックに応じて0または1 replicaで動作する。
SCALING_MODE=disabled
SCALING_MIN_REPLICAS=0
SCALING_COOLDOWN_PERIOD=3600

# ACRとStorage Accountをグローバルに一意にする英小文字・数字6文字。
# `openssl rand -hex 3` で一度だけ生成し、以後は変更しない。
SUFFIX=replace_me

ACR_NAME="acrcodeserver${SUFFIX}"
STORAGE_ACCOUNT="stcodeserver${SUFFIX}"

# 公開済みの不変tagを指定する。空の場合、管理CLIは既存の `-1` App、続いて
# ACRの最新tagから復元する。
IMAGE_TAG=replace_with_immutable_tag
